# ============================================
# Azure OpenAI — Primary Model (PM Agent)
# ============================================
AZURE_API_KEY=<your-real-key>
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# PM Agent uses the larger model
PM_MODEL_DEPLOYMENT=gpt-4o
PM_MODEL_NAME=azure/gpt-4o

# Coder & QA use the smaller/faster model
CODER_MODEL_DEPLOYMENT=gpt-4o-mini
CODER_MODEL_NAME=azure/gpt-4o-mini
QA_MODEL_DEPLOYMENT=gpt-4o-mini
QA_MODEL_NAME=azure/gpt-4o-mini

# ============================================
# Agent Configuration
# ============================================
MAX_REACT_ITERATIONS=10
EXEC_TIMEOUT_SECONDS=10
SLIDING_WINDOW_SIZE=10
MAX_QA_ITERATIONS=5
QA_TEST_TIMEOUT=30

# ============================================
# Resilience
# ============================================
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=60

# ============================================
# Cost Tracking
# ============================================
GPT4O_INPUT_COST_PER_1K=0.0025
GPT4O_OUTPUT_COST_PER_1K=0.01
GPT4O_MINI_INPUT_COST_PER_1K=0.00015
GPT4O_MINI_OUTPUT_COST_PER_1K=0.0006
COST_REPORT_DIR=./docs/cost_reports

# ============================================
# Prompt Cache
# ============================================
PROMPT_CACHE_TTL=3600
PROMPT_CACHE_MAX_SIZE=100

# ============================================
# Memory
# ============================================
CHROMA_COLLECTION_NAME=coder_agent_memory
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_USE_HTTP=false

# ============================================
# Observability
# ============================================
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=multi-agent-dev-team
PHOENIX_ENDPOINT=http://localhost:6006
# ============================================
# Azure OpenAI Configuration
# ============================================
# PRIMARY keys that CrewAI native Azure provider reads:
AZURE_API_KEY=<your-real-azure-api-key>
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview

# CrewAI also checks these as fallbacks for the endpoint:
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# Deployment name (used by our code)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ============================================
# Agent Configuration
# ============================================
MAX_REACT_ITERATIONS=10
EXEC_TIMEOUT_SECONDS=10
SLIDING_WINDOW_SIZE=10
CHROMA_COLLECTION_NAME=coder_agent_memory
CHROMA_PERSIST_DIR=./chroma_store